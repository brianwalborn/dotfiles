#!/usr/bin/env zsh

autoload -Uz vcs_info context;
precmd() { vcs_info; }
zstyle ':vcs_info:git:*' formats '%b';
setopt PROMPT_SUBST;

# include kubernetes context if kubectl is installed and a context is set
if type "kubectl" > /dev/null; then
  PROMPT='%F{49}%n%f $(ctx=$(kubectl config current-context 2>/dev/null); [[ -n "$ctx" ]] && echo "%F{39}[$ctx]%f ")%1d %F{208}(${vcs_info_msg_0_})%f λ ';
else
  PROMPT='%F{49}%n%f %1d %F{208}(${vcs_info_msg_0_})%f λ ';
fi
